# Virtual environment — never push, machine-specific, huge, regenerate with pip install
.venv/
venv/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# MLflow
mlruns/
mlflow.db
mlflow_artifacts/
mlartifacts/

# Data — regenerated by generate_datasets.py / clean_data.py / merge_data.py.
# These files are large (master_features.csv is ~48MB) and shouldn't live in git.
# Keep the folder structure with .gitkeep so the repo layout is still visible.
data/raw/*
data/processed/*
data/outputs/*
data/delta/
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/outputs/.gitkeep

# Trained models — regenerated by retrain_all.py
models/*.pkl
models/validation_metrics.json

# Airflow runtime
airflow/logs/
airflow/plugins/__pycache__/

# Environment secrets
.env

# OS / editor junk
.DS_Store
Thumbs.db
.vscode/
*.swp

# Spark checkpoints
data/delta/checkpoints/data/external_sources/
data/external_sources/
